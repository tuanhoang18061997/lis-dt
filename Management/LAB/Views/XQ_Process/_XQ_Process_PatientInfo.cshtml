@using Management.BL
@using Management.Models
@using Management.Models.ViewModels.CDHA

@{
    var patientInfo =
        ViewData["patientInfo"]
            as Patient;

    var users =
        ViewData["lstUser"]
            as List<User>
        ?? new List<User>();

    var medicalRecords =
        ViewData["lstBenhAnModel"]
            as List<BenhAnModel>
        ?? new List<BenhAnModel>();

    long? userLoginId =
        null;

    if (
        ViewData["userLoginId"]
        != null
    )
    {
        userLoginId =
            Convert.ToInt64(
                ViewData["userLoginId"]
            );
    }

    var model =
        CdhaProcessViewModel
            .CreateXqPatientInfo(
                patientInfo,
                users,
                medicalRecords,
                userLoginId
            );
}

@await Html.PartialAsync(
"~/Views/Shared/CDHA/Process/_ProcessPatientInfo.cshtml",
    model
)