@using Management.Models.ViewModels.CDHA

@{
    var patients =
        ViewData["lstPatient"]
            as List<Patient>
        ?? new List<Patient>();

    var model =
        new CdhaProcessViewModel
        {
            Options =
                CdhaProcessViewModel
                    .CreateXqOptions(),

            Patients =
                patients
        };
}

@await Html.PartialAsync(
"~/Views/Shared/CDHA/Process/_ProcessPatientList.cshtml",
    model
)