@using Management.Models
@using Management.Models.ViewModels.CDHA

@{
    var results =
        ViewData["lstResultCDHAs"]
            as List<ResultCDHA>;

    if (results == null)
    {
        results =
            ViewData["lstresultCDHAs"]
                as List<ResultCDHA>;
    }

    results ??=
        new List<ResultCDHA>();


    var model =
        new CdhaProcessViewModel
        {
            Options =
                CdhaProcessViewModel
                    .CreateXqOptions(),

            Results =
                results
        };
}

@await Html.PartialAsync(
"~/Views/Shared/CDHA/Process/_ProcessWorkspace.cshtml",
    model
)