<div class="ns-right-info-title">DANH SÁCH BỆNH NHÂN</div>
<div>
    <input type="text" id="ns_getsample_pidorseq" class="form-control height-28" placeholder="Tìm theo PID hoặc SEQ" />
</div>
<div class="div-margin-top-5">
    <input type="date" id="ns_getsample_timeSearchFrom" class="form-control height-28" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
</div>
<div class="div-margin-top-5">
    <input type="date" id="ns_getsample_timeSearchTo" class="form-control height-28" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
</div>
<div class="div-margin-top-5">
    <button id="ns_getsample_refresh" class="btn btn-success btn-blue width-20" onclick="GetSample_Refresh()">
        <i class="bi bi-arrow-clockwise"></i> Refresh
    </button>
    <button id="ns_getsample_search" class="btn btn-success btn-blue width-20" onclick="GetSample_Search()">
        <i class="bi bi-search"></i> Tìm kiếm
    </button>
</div>
