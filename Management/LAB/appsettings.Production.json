{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "LABConnectionString": "CONNECTION_STRING_DATABASE_THAT_CUA_PROJECT_A"
  },

  "PacsTls": {
    "CaCertificatePath": "C:\\PACS-HTTPS-VERIFY\\PublicCerts\\ca.crt"
  },

  "Pacs": {
    "WorklistFolder": "",
    "WorklistStagingFolder": "",
    "WorklistQuarantineFolder": "",

    "Dump2DcmPath": "C:\\dcmtk\\bin\\dump2dcm.exe",
    "DcmDumpPath": "C:\\dcmtk\\bin\\dcmdump.exe",

    "InstitutionName": "",

    "DefaultScheduledStationAETitle": "",

    "ScheduledStationAETitle_CR": "",
    "ScheduledStationName_CR": "",
    "ScheduledProcedureStepLocation_CR": "XQ_ROOM",

    "ScheduledStationAETitle_DX": "",
    "ScheduledStationName_DX": "",
    "ScheduledProcedureStepLocation_DX": "XQ_ROOM",

    "ScheduledStationAETitle_XQ": "",
    "ScheduledStationName_XQ": "",
    "ScheduledProcedureStepLocation_XQ": "XQ_ROOM",

    "LocalPacsIp": "",
    "LocalPacsAeTitle": "",
    "LocalPacsDicomPort": 4242,

    "OrthancBaseUrl": "",
    "OrthancUsername": "",
    "OrthancPassword": "",

    "OhifHttpBaseUrl": "",
    "OhifHttpsBaseUrl": "",
    "OhifBaseUrl": ""
  },

  "ReverseProxy": {
    "Routes": {
      "ohif-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/ohif/{**catch-all}"
        }
      },

      "ohif-app-config-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/app-config.js"
        }
      },

      "ohif-manifest-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/manifest.json"
        }
      },

      "ohif-init-service-worker-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/init-service-worker.js"
        }
      },

      "ohif-service-worker-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/service-worker.js"
        }
      },

      "ohif-app-bundle-js-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/app.bundle.{hash}.js"
        }
      },

      "ohif-app-bundle-css-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/app.bundle.css"
        }
      },

      "ohif-dynamic-bundle-js-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/{name}.bundle.{hash}.js"
        }
      },

      "ohif-dynamic-css-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/{name}.css"
        }
      },

      "ohif-worker-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/{name}.worker.js"
        }
      },

      "ohif-worker-hash-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/{name}.{hash}.worker.js"
        }
      },

      "ohif-assets-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/assets/{**catch-all}"
        }
      },

      "dicom-web-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/dicom-web/{**catch-all}"
        }
      },

      "wado-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/wado/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "ohif-cluster": {
        "Destinations": {
          "ohif-destination": {
            "Address": "http://127.0.0.1:3000/"
          }
        }
      }
    }
  }
}