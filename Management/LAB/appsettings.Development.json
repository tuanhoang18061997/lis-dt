  "ReverseProxy": {
    "Routes": {

      "ohif-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/ohif/{**catch-all}"
        }
      },

      "ohif-app-config-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/app-config.js"
        }
      },

      "ohif-manifest-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/manifest.json"
        }
      },

      "ohif-init-service-worker-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/init-service-worker.js"
        }
      },

      "ohif-service-worker-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/service-worker.js"
        }
      },

      "ohif-favicon-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/favicon.ico"
        }
      },

      "ohif-app-bundle-js-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/__pacs_disabled_app_bundle_test"
        }
      },

      "ohif-app-bundle-css-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/app.bundle.css"
        }
      },

      "ohif-dynamic-bundle-js-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/{name}.bundle.{hash}.js"
        }
      },

      "ohif-dynamic-css-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/{name}.css"
        }
      },

      "ohif-worker-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/{name}.worker.js"
        }
      },

      "ohif-worker-hash-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/{name}.{hash}.worker.js"
        }
      },

      "ohif-assets-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/assets/{**catch-all}"
        }
      },

      "dicom-web-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/dicom-web/{**catch-all}"
        }
      },

      "wado-route": {
        "ClusterId": "ohif-cluster",
        "Match": {
          "Path": "/wado/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "ohif-cluster": {
        "Destinations": {
          "ohif-destination": {
            "Address": "https://192.168.10.106/"
          }
        }
      }
    }
  }
